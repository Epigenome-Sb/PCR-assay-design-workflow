# ============================================================
# PCR Assay Design Workflow
# Git ignore rules
# ============================================================

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# ============================================================
# Workflow intermediate files
# ============================================================

work/

# ============================================================
# Generated results
# ============================================================

results/*
!results/README.md
!results/.gitkeep

# ============================================================
# Biological input data
# ============================================================

data/design/*
data/validation/*

# Keep directory structure
!data/design/.gitkeep
!data/validation/.gitkeep

# Common biological sequence files elsewhere under data/
data/**/*.fa
data/**/*.fasta
data/**/*.fna
data/**/*.fas
data/**/*.fastq
data/**/*.fq
data/**/*.fastq.gz
data/**/*.fq.gz

# ============================================================
# Logs and temporary files
# ============================================================

*.log
*.tmp
*.temp

# ============================================================
# Editors / operating systems
# ============================================================

.vscode/
.idea/
.DS_Store
Thumbs.db